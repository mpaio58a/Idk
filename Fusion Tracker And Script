local bindable = Instance.new("BindableFunction")

bindable.OnInvoke = function(buttonText)
    if buttonText == "25%" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/mpaio58a/Webhook/refs/heads/main/25%25%20progess"))()
    elseif buttonText == "Normal" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/mpaio58a/Webhook/refs/heads/main/normal%20script"))()
    end
end

