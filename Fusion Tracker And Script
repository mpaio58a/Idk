local bindable = Instance.new("BindableFunction")

bindable.OnInvoke = function(buttonText)
    if buttonText == "Special" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/mpaio58a/Idk/refs/heads/main/Alpha_Script.txt"))()
    elseif buttonText == "Normal" then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/mpaio58a/Idk/refs/heads/main/Kitty%20For%20Service"))()
    end
end

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Read Me",
    Text = "Sorry, I haven't worked on this script for 3 months—my bad for forgetting to mention it! I plan to get back to it next year.",
    Duration = 80000,
    Callback = bindable,
    Button1 = "25%",
    Button2 = "Normal"
})

